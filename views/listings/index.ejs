<% layout('/layout/boilerplate') -%>
<%= success || "" %><!-- <h3>All Listings</h3> -->
<%
// Defaults keep the page rendering even if an older server version
// (without filters/pagination locals) serves this template.
const f = typeof filters !== "undefined" ? filters : { q: "", minPrice: "", maxPrice: "", guests: "", checkIn: "", checkOut: "" };
const pg = typeof page !== "undefined" ? page : 1;
const tpgs = typeof totalPages !== "undefined" ? totalPages : 1;
const ttl = typeof total !== "undefined" ? total : (typeof listings !== "undefined" ? listings.length : 0);
const bq = typeof baseQuery !== "undefined" ? baseQuery : "";
%>

<style>
/* Parent bar */
.filters-bar {
  display: flex;
  align-items: center;        /* vertical alignment */
  justify-content: space-between;
  gap: 1.5rem;
  padding: 1rem;
}

/* Filters (icons) */
#filters {
  display: flex;
  flex-direction: row;
  align-items: center;
}

/* Individual filter */
.filter {
  text-align: center;
  opacity: 0.6;
  margin: 0 1rem;
}

.filter:hover {
  opacity: 1;
  cursor: pointer;
}

.filter span {
  font-size: 0.8rem;
}

/* Make icons & text black */
#filters a {
  color: #000;
  text-decoration: none;
}

/* Tax toggle box */
.tax-toggle {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  border: 1px solid black;
  border-radius: 25px;
  padding: 0.5rem 1rem;
  height: 45px;
  white-space: nowrap;
}

/* Tax-inclusive prices: hidden until the toggle is on */
.price-tax {
  display: none;
}
body.show-tax .price-base {
  display: none;
}
body.show-tax .price-tax {
  display: inline;
}

/* Pagination in site theme (pink like Reserve/Search buttons) */
.pagination .page-link{
  color: #222;
}
.pagination .page-link:hover{
  color: #e61e4d;
}
.pagination .page-item.active .page-link{
  background: linear-gradient(to right, #e61e4d, #d90b63);
  border-color: #e61e4d;
  color: #fff;
}
.pagination .page-item.active .page-link:hover{
  color: #fff;
}
.pagination .page-item.disabled .page-link{
  color: #aaa;
}
.pagination .page-item:first-child .page-link{
  border-radius: 12px 0 0 12px;
}
.pagination .page-item:last-child .page-link{
  border-radius: 0 12px 12px 0;
}


</style>



<div class="filters-bar">
  <div id="filters">
  <a href="/listings?category=Trending" class="filter">
    <i class="fa-solid fa-fire"></i><br>
    <span>Trending</span>
  </a>

  <a href="/listings?category=Rooms" class="filter">
    <i class="fa-solid fa-bed"></i><br>
    <span>Rooms</span>
  </a>

  <a href="/listings?category=Farms" class="filter">
    <i class="fa-solid fa-tractor"></i><br>
    <span>Farms</span>
  </a>

  <a href="/listings?category=Iconic Cities" class="filter">
    <i class="fa-solid fa-city"></i><br>
    <span>Iconic Cities</span>
  </a>

  <a href="/listings?category=Pools" class="filter">
    <i class="fa-solid fa-person-swimming"></i><br>
    <span>Pools</span>
  </a>

  <a href="/listings?category=Beach" class="filter">
    <i class="fa-solid fa-umbrella-beach"></i><br>
    <span>Beach</span>
  </a>

  <a href="/listings?category=Pet-friendly" class="filter">
    <i class="fa-solid fa-paw"></i><br>
    <span>Pet-friendly</span>
  </a>

  <a href="/listings?category=Arctic" class="filter">
    <i class="fa-solid fa-snowflake"></i><br>
    <span>Arctic</span>
  </a>

  <a href="/listings?category=Sunrise" class="filter">
    <i class="fa-solid fa-sun"></i><br>
    <span>Sunrise</span>
  </a>

  <a href="/listings?category=Horse Riding" class="filter">
    <i class="fa-solid fa-horse"></i><br>
    <span>Horse Riding</span>
  </a>
</div>


  <div class="tax-toggle">
    <div class="form-check-reverse form-switch">
  <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
  <label class="form-check-label" for="switchCheckDefault">Include Taxes</label>
    </div>
  </div>
</div>

</div>

<% if (!listings.length) { %>
<div class="alert alert-info">No listings match your filters. Try clearing them.</div>
<% } %>

<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4 mt-0">
<% listings.forEach(function(listing) { %>
  <div class="col">
  <a href="/listings/<%= listing._id %>" class="listing_link text-decoration-none text-dark">
    <div class="card mx-auto h-100" style="width: 20rem; border-radius: 1rem; overflow: hidden;">
      <img
        src="<%= (listing.images && listing.images.length && listing.images[0].url) || (listing.image && listing.image.url) || 'https://via.placeholder.com/400x300?text=No+Image' %>"
        class="card-img-top"
        alt="<%= listing.title %>"
        style="height:20rem; object-fit:cover;"
        onerror="this.onerror=null; this.src='https://via.placeholder.com/400x300?text=Image+Error'"
      />
      <div class="card-body px-1">
        <p class="card-text">
          <strong><%= listing.title %></strong><br>
          <% if (listing.reviewCount) { %>
          &#9733; <%= listing.avgRating %> (<%= listing.reviewCount %>)<br>
          <% } %>
          <span class="price-base">₹<%= listing.price.toLocaleString("en-IN") %> / night<i class="tax-info"> &nbsp; +18% GST</i></span>
          <span class="price-tax">₹<%= Math.round(listing.price * 1.18).toLocaleString("en-IN") %> / night<i> &nbsp; incl. taxes</i></span>

        </p>
      </div>
    </div>
  </a>
  </div>

<% }) %>

</div>

<% if (tpgs > 1) { %>
<nav class="mt-4">
  <ul class="pagination justify-content-center">
    <li class="page-item <%= pg <= 1 ? 'disabled' : '' %>">
      <a class="page-link" href="/listings?<%= bq %><%= bq ? '&' : '' %>page=<%= pg - 1 %>">Prev</a>
    </li>
    <% for (let p = 1; p <= tpgs; p++) { %>
    <li class="page-item <%= p === pg ? 'active' : '' %>">
      <a class="page-link" href="/listings?<%= bq %><%= bq ? '&' : '' %>page=<%= p %>"><%= p %></a>
    </li>
    <% } %>
    <li class="page-item <%= pg >= tpgs ? 'disabled' : '' %>">
      <a class="page-link" href="/listings?<%= bq %><%= bq ? '&' : '' %>page=<%= pg + 1 %>">Next</a>
    </li>
  </ul>
</nav>
<% } %>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const taxSwitch = document.getElementById("switchCheckDefault");

  if (!taxSwitch) return;

  taxSwitch.checked = false;
  document.body.classList.remove("show-tax");

  taxSwitch.addEventListener("change", () => {
    document.body.classList.toggle("show-tax", taxSwitch.checked);
  });
});
</script>
