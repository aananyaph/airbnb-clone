<% layout('/layout/boilerplate') -%>
<body class="p-4">

<h2>My Trips</h2>

<% if(!bookings || bookings.length === 0) { %>
  <div class="alert alert-info">
    No bookings yet. Reserve a listing to start your trips!
  </div>
<% } else { %>
  <div class="table-responsive">
    <table class="table table-striped table-bordered">
      <thead>
        <tr>
          <th>Listing</th>
          <th>Dates</th>
          <th>Guests</th>
          <th>Total</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% for (let booking of bookings) { %>
        <tr>
          <td>
            <% if (booking.listing && booking.listing.image) { %>
            <img src="<%= booking.listing.image.url %>" alt="listing" style="width: 50px; height: 50px; object-fit: cover; border-radius: 5px;">
            <% } %>
            <%= booking.listing ? booking.listing.title : "Deleted listing" %>
          </td>
          <td>
            <%= booking.checkIn ? (new Date(booking.checkIn)).toLocaleDateString('en-IN') : 'N/A' %> -
            <%= booking.checkOut ? (new Date(booking.checkOut)).toLocaleDateString('en-IN') : 'N/A' %>
          </td>
          <td><%= booking.guests %></td>
          <td>₹<%= booking.totalPrice ? booking.totalPrice.toLocaleString('en-IN') : 'N/A' %></td>
          <td>
            <% if (booking.paymentStatus === 'paid') { %>
              <span class="badge bg-success">Paid</span>
            <% } else if (booking.paymentStatus === 'refunded') { %>
              <span class="badge bg-secondary">Refunded</span>
            <% } else if (booking.paymentStatus === 'failed') { %>
              <span class="badge bg-danger">Failed</span>
            <% } else if (booking.status === 'cancelled') { %>
              <span class="badge bg-secondary">Cancelled</span>
            <% } else if (booking.status === 'pending') { %>
              <span class="badge bg-warning text-dark">Pending</span>
            <% } else { %>
              <span class="badge bg-success">Confirmed</span>
            <% } %>
          </td>
          <td>
            <% const inDay = booking.checkIn ? new Date(booking.checkIn) : null; %>
            <% if (inDay) { inDay.setHours(0,0,0,0); } %>
            <% const day = new Date(); day.setHours(0,0,0,0); %>
            <% const ageMin = booking.createdAt ? (new Date() - new Date(booking.createdAt)) / (1000 * 60) : 999; %>
            <% if (booking.status === 'pending' && ageMin < 15 && inDay && inDay > day) { %>
              <a href="/bookings/<%= booking._id %>/checkout" class="btn btn-sm btn-warning">Retry payment</a>
            <% } else if (booking.status === 'pending') { %>
              <span class="text-muted">Expired</span>
            <% } else if (booking.status === 'confirmed' && inDay && inDay > day) { %>
              <form method="POST" action="/bookings/<%= booking._id %>/cancel?_method=PUT">
                <button class="btn btn-sm btn-danger">Cancel</button>
              </form>
            <% } else if (booking.status === 'confirmed') { %>
              <span class="text-muted">Past / ongoing</span>
            <% } else { %>
              <span class="text-muted">Cancelled</span>
            <% } %>
          </td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>
<% } %>

</body>
